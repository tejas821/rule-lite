{
  "name": "rule-lite",
  "version": "0.1.0",
  "description": "Tiny, dependency-free TypeScript engine for evaluating JSON-defined conditional rules — for dynamic forms, feature flags, and business rules in enterprise apps.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "rule-engine",
    "json-logic",
    "conditional-logic",
    "business-rules",
    "dynamic-forms",
    "feature-flags",
    "typescript"
  ],
  "author": "Tejas Kadam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejas821/rule-lite.git"
  },
  "homepage": "https://github.com/tejas821/rule-lite#readme",
  "bugs": {
    "url": "https://github.com/tejas821/rule-lite/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=16"
  }
}
